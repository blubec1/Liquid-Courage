@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using DrunkenBarFight;
@inherits PanelComponent
@namespace DrunkenBarFight

<root>
	<div class="menu-root @(Visible ? "visible" : "") @(_screen == MenuScreen.Customize ? "customize-mode" : "")">

		<!-- Ash + neon glow render on every screen, including Customize - only the title/footer stay
		     screen-specific below. -->
		<div class="glow glow-a" style="opacity:@(GlowAAlpha.ToString( "0.##" ));"></div>
		<div class="glow glow-b" style="opacity:@(GlowBAlpha.ToString( "0.##" ));"></div>

		<div class="motes">
			@foreach ( var m in Motes )
			{
				<div class="mote @(m.IsEmber ? "mote-ember" : "mote-ash")" style="left:@(m.LeftPercent.ToString( "0.##" ))%; bottom:@(m.Bottom.ToString( "0.##" ))px; opacity:@(m.Opacity.ToString( "0.##" )); width:@(m.Size.ToString( "0.#" ))px; height:@(m.Size.ToString( "0.#" ))px;"></div>
			}
		</div>

		<div class="panel" style="box-shadow:@(PanelBoxShadow);">

			<div class="accent-bar"></div>
			<div class="corner corner-tl"></div>
			<div class="corner corner-tr"></div>
			<div class="corner corner-bl"></div>
			<div class="corner corner-br"></div>

			@if ( _screen != MenuScreen.Customize )
			{
				<div class="title-wrap">
					<div class="title-line1" style="transform:scale(@(TitlePulse.ToString( "0.###" ))); text-shadow:@(TitleTextShadowSmall);">DRUNKEN</div>
					<div class="title-line2" style="transform:scale(@(TitlePulse.ToString( "0.###" ))); text-shadow:@(TitleTextShadow);">BAR FIGHT</div>
				</div>
			}

			@if ( _screen == MenuScreen.Root )
			{
				<div class="nav">
					<div class="nav-button primary" style="box-shadow:0 0 @(PlayGlowSize.ToString( "0.#" ))px rgba(224,48,58,@(PlayGlowAlpha.ToString( "0.##" ))); transform:scale(@(PlayPulse.ToString( "0.###" )));" onclick="@PlayClicked">PLAY</div>
					<div class="nav-button" onclick="@GoToCustomize">CUSTOMIZE</div>
					<div class="nav-button" onclick="@GoToHowToPlay">HOW TO PLAY</div>
					<div class="nav-button" onclick="@GoToSettings">SETTINGS</div>
				</div>
			}

			@if ( _screen == MenuScreen.Customize )
			{
				<div class="sub-title">CUSTOMIZE</div>

				<div class="customize-list">
					<div class="customize-row">
						<div class="customize-label">SKIN</div>
						<div class="customize-control">
							<div class="stepper-button" onclick="@SkinPrev">&lt;</div>
							<div class="customize-value">@SkinLabel</div>
							<div class="stepper-button" onclick="@SkinNext">&gt;</div>
						</div>
					</div>

					<div class="customize-row">
						<div class="customize-label">TOP</div>
						<div class="customize-control">
							<div class="stepper-button" onclick="@TopPrev">&lt;</div>
							<div class="customize-value">@TopLabel</div>
							<div class="stepper-button" onclick="@TopNext">&gt;</div>
						</div>
					</div>

					<div class="customize-row">
						<div class="customize-label">BOTTOM</div>
						<div class="customize-control">
							<div class="stepper-button" onclick="@BottomPrev">&lt;</div>
							<div class="customize-value">@BottomLabel</div>
							<div class="stepper-button" onclick="@BottomNext">&gt;</div>
						</div>
					</div>

					<div class="customize-row">
						<div class="customize-label">SHOES</div>
						<div class="customize-control">
							<div class="stepper-button" onclick="@ShoesPrev">&lt;</div>
							<div class="customize-value">@ShoesLabel</div>
							<div class="stepper-button" onclick="@ShoesNext">&gt;</div>
						</div>
					</div>

					<div class="customize-row">
						<div class="customize-label">HEAD</div>
						<div class="customize-control">
							<div class="stepper-button" onclick="@HeadPrev">&lt;</div>
							<div class="customize-value">@HeadLabel</div>
							<div class="stepper-button" onclick="@HeadNext">&gt;</div>
						</div>
					</div>

					<div class="customize-row">
						<div class="customize-label">ACCESSORY</div>
						<div class="customize-control">
							<div class="stepper-button" onclick="@AccessoryPrev">&lt;</div>
							<div class="customize-value">@AccessoryLabel</div>
							<div class="stepper-button" onclick="@AccessoryNext">&gt;</div>
						</div>
					</div>

					<div class="customize-row">
						<div class="customize-label">ROTATE</div>
						<div class="customize-control">
							<div class="stepper-button" onclick="@RotateLeft">&lt;</div>
							<div class="stepper-button" onclick="@RotateRight">&gt;</div>
						</div>
					</div>
				</div>

				<div class="nav-button back" onclick="@GoToRoot">BACK</div>
			}

			@if ( _screen == MenuScreen.HowToPlay )
			{
				<div class="sub-title">HOW TO PLAY</div>

				<div class="controls">
					<div class="control-row"><div class="key">WASD</div><div class="desc">Move</div></div>
					<div class="control-row"><div class="key">Mouse</div><div class="desc">Aim</div></div>
					<div class="control-row"><div class="key">LMB</div><div class="desc">Punch</div></div>
					<div class="control-row"><div class="key">RMB</div><div class="desc">Heavy Attack</div></div>
					<div class="control-row"><div class="key">E</div><div class="desc">Leg Sweep (90&deg; arc)</div></div>
					<div class="control-row"><div class="key">G</div><div class="desc">Throw Bottle</div></div>
					<div class="control-row"><div class="key">Esc</div><div class="desc">Pause</div></div>
				</div>

				<div class="tip">Land hits to build your combo. Beat enemies to fill the drink meter -
					each glass makes you hit harder and take less damage, but past 130 the room starts to
					blur. 150 and you black out.</div>

				<div class="nav-button back" onclick="@GoToRoot">BACK</div>
			}

			@if ( _screen == MenuScreen.Settings )
			{
				<div class="sub-title">SETTINGS</div>

				<div class="setting-row">
					<div class="setting-label">Master Volume</div>
					<div class="setting-control">
						<div class="stepper-button" onclick="@VolumeDown">-</div>
						<div class="setting-bar-bg"><div class="setting-bar-fill" style="width:@((Settings.MasterVolume * 100).ToString( "0.##" ))%;"></div></div>
						<div class="stepper-button" onclick="@VolumeUp">+</div>
					</div>
				</div>

				<div class="setting-row">
					<div class="setting-label">Resolution</div>
					<div class="setting-control">
						<div class="choice-button" onclick="@CycleResolution">@ResolutionLabel</div>
					</div>
				</div>

				<div class="setting-row">
					<div class="setting-label">Fullscreen</div>
					<div class="setting-control">
						<div class="choice-button @(Settings.Fullscreen ? "on" : "off")" onclick="@ToggleFullscreen">@(Settings.Fullscreen ? "ON" : "OFF")</div>
					</div>
				</div>

				<div class="settings-note">Resolution/fullscreen are saved as a preference here but
					aren't applied automatically - change those in s&box's own video settings.</div>

				<div class="nav-button back" onclick="@GoToRoot">BACK</div>
			}

		</div>

		@if ( _screen != MenuScreen.Customize )
		{
			<div class="footer">last call comes for everyone</div>
		}

	</div>
</root>

@code
{
	enum MenuScreen { Root, HowToPlay, Settings, Customize }

	MenuScreen _screen = MenuScreen.Root;

	public bool Visible => GameManager.Instance?.State == RunState.MainMenu;

	public const int MoteCount = 20;

	GameSettings Settings => GameSettings.Instance;

	public string ResolutionLabel => Settings.ResolutionLabel( Settings.ResolutionIndex );

	// --- Ambient "alive" motion, all driven from C# via Time.Now (see BuildHash's time bucket
	// below) and applied as inline styles - the same proven pattern Hud.razor already uses for its
	// sway/vignette effects. CSS @keyframes/animation was the original approach here but didn't
	// actually render in practice, so every continuously-moving value on this screen is computed
	// per-frame in code instead of left to a CSS animation loop. ---

	public float TitlePulse => 1f + MathF.Sin( Time.Now * 1.6f ) * 0.015f;

	float TitleGlowAlpha => 0.55f + MathF.Sin( Time.Now * 2.1f ) * 0.25f;
	public string TitleTextShadow => $"0 2px 10px black, 0 0 24px rgba(224,48,58,{TitleGlowAlpha.ToString( "0.##" )})";
	public string TitleTextShadowSmall => $"0 2px 8px black, 0 0 16px rgba(224,48,58,{(TitleGlowAlpha * 0.8f).ToString( "0.##" )})";

	float PanelGlowAlpha => 0.16f + MathF.Sin( Time.Now * 1.1f ) * 0.09f;
	public string PanelBoxShadow => $"0 10px 40px rgba(0,0,0,0.55), 0 0 34px rgba(224,48,58,{PanelGlowAlpha.ToString( "0.##" )})";

	public float PlayPulse => 1f + MathF.Sin( Time.Now * 2.4f ) * 0.018f;
	public float PlayGlowAlpha => 0.3f + MathF.Sin( Time.Now * 2.4f ) * 0.22f;
	public float PlayGlowSize => 20f + MathF.Sin( Time.Now * 2.4f ) * 10f;

	public float GlowAAlpha => 0.5f + MathF.Sin( Time.Now * 0.5f ) * 0.3f;
	public float GlowBAlpha => 0.45f + MathF.Sin( Time.Now * 0.4f + 2f ) * 0.25f;

	public struct MoteView
	{
		public float LeftPercent;
		public float Bottom;
		public float Opacity;
		public float Size;
		public bool IsEmber;
	}

	/// <summary>
	/// Ash drifting down from a fire, with a few glowing embers still rising through it - computed
	/// per-mote from Time.Now rather than a CSS animation (same reasoning as the rest of this
	/// file: CSS @keyframes didn't reliably render here). Each mote has a fixed left position and
	/// duration derived from its index so it's stable frame to frame, and loops via modulo.
	/// Roughly 1 in 4 are embers (small, warm, rising fast); the rest are ash (larger, cooler grey,
	/// sinking slowly with a gentle horizontal sway) - a mix that reads as "ash from a fire"
	/// instead of a uniform shower of sparks.
	/// </summary>
	public IEnumerable<MoteView> Motes
	{
		get
		{
			for ( int i = 0; i < MoteCount; i++ )
			{
				var isEmber = i % 4 == 0;
				var duration = isEmber ? (3f + (i % 4) * 0.5f) : (6.5f + (i % 5) * 1.4f);
				var phase = i * 0.71f * duration;
				var t = ((Time.Now + phase) % duration) / duration;

				var baseLeft = (3f + i * 6.1f) % 96f;
				var sway = MathF.Sin( Time.Now * 0.6f + i * 1.7f ) * (isEmber ? 1.5f : 4f);
				var left = System.Math.Clamp( baseLeft + sway, 0f, 98f );

				float bottom;
				float opacity;

				if ( isEmber )
				{
					// Rises fast and flickers, same as before but quicker so it doesn't feel sluggish.
					bottom = t * 600f - 10f;
					var flicker = 0.6f + MathF.Sin( Time.Now * 10f + i ) * 0.3f;
					opacity = (t < 0.1f ? (t / 0.1f) : (t > 0.82f ? (1f - t) / 0.18f : 1f)) * flicker;
				}
				else
				{
					// Ash flake: starts high and settles downward slowly, like it's falling out of
					// smoke rather than rising out of embers.
					bottom = (1f - t) * 560f + 15f;
					opacity = (t < 0.08f ? (t / 0.08f) : (t > 0.88f ? (1f - t) / 0.12f : 1f)) * 0.5f;
				}

				yield return new MoteView
				{
					LeftPercent = left,
					Bottom = bottom,
					Opacity = MathF.Max( 0f, opacity ),
					Size = isEmber ? 3f : (3f + (i % 3) * 1.2f),
					IsEmber = isEmber,
				};
			}
		}
	}

	void PlayClicked()
	{
		PlayerPreviewCamera.Instance?.SetActive( false );
		PlayerPreviewCamera.Instance?.SetAsMainCamera( false );
		PlayerPreviewRotator.Instance?.SetVisible( false );
		_screen = MenuScreen.Root;
		GameManager.Instance?.StartGame();
	}

	void GoToHowToPlay() => _screen = MenuScreen.HowToPlay;
	void GoToSettings() => _screen = MenuScreen.Settings;

	void GoToRoot()
	{
		if ( _screen == MenuScreen.Customize )
		{
			PlayerPreviewCamera.Instance?.SetActive( false );
			PlayerPreviewCamera.Instance?.SetAsMainCamera( false );
			PlayerPreviewRotator.Instance?.SetVisible( false );
		}

		_screen = MenuScreen.Root;
	}

	void GoToCustomize()
	{
		_screen = MenuScreen.Customize;
		PlayerPreviewCamera.Instance?.SetActive( true );
		PlayerPreviewCamera.Instance?.SetAsMainCamera( true );
		PlayerPreviewRotator.Instance?.SetVisible( true );

		// Push the already-saved outfit onto the preview stand right away - otherwise it only shows
		// up after the first slot click, since Cycle() is what triggers ApplyToLivePlayerIfPresent
		// and nothing calls it just from opening the screen.
		Outfit.ApplyTo( PlayerPreviewRotator.Instance?.BodyRenderer );
	}

	// --- Customize screen: dedicated no-arg method per slot per direction (no lambda-in-onclick -
	// this codebase has no precedent for that pattern, plain named methods are the proven path). ---

	PlayerOutfit Outfit => PlayerOutfit.Instance;

	string SkinLabel => Outfit.GetSelectedTitle( PlayerOutfit.Slot.Skin ) ?? "Default";
	string TopLabel => Outfit.GetSelectedTitle( PlayerOutfit.Slot.Top ) ?? "None";
	string BottomLabel => Outfit.GetSelectedTitle( PlayerOutfit.Slot.Bottom ) ?? "None";
	string ShoesLabel => Outfit.GetSelectedTitle( PlayerOutfit.Slot.Shoes ) ?? "None";
	string HeadLabel => Outfit.GetSelectedTitle( PlayerOutfit.Slot.Head ) ?? "None";
	string AccessoryLabel => Outfit.GetSelectedTitle( PlayerOutfit.Slot.Accessory ) ?? "None";

	void SkinPrev() => Outfit.CyclePrev( PlayerOutfit.Slot.Skin );
	void SkinNext() => Outfit.CycleNext( PlayerOutfit.Slot.Skin );
	void TopPrev() => Outfit.CyclePrev( PlayerOutfit.Slot.Top );
	void TopNext() => Outfit.CycleNext( PlayerOutfit.Slot.Top );
	void BottomPrev() => Outfit.CyclePrev( PlayerOutfit.Slot.Bottom );
	void BottomNext() => Outfit.CycleNext( PlayerOutfit.Slot.Bottom );
	void ShoesPrev() => Outfit.CyclePrev( PlayerOutfit.Slot.Shoes );
	void ShoesNext() => Outfit.CycleNext( PlayerOutfit.Slot.Shoes );
	void HeadPrev() => Outfit.CyclePrev( PlayerOutfit.Slot.Head );
	void HeadNext() => Outfit.CycleNext( PlayerOutfit.Slot.Head );
	void AccessoryPrev() => Outfit.CyclePrev( PlayerOutfit.Slot.Accessory );
	void AccessoryNext() => Outfit.CycleNext( PlayerOutfit.Slot.Accessory );

	void RotateLeft() => PlayerPreviewRotator.Instance?.Nudge( -30f );
	void RotateRight() => PlayerPreviewRotator.Instance?.Nudge( 30f );

	void VolumeDown() => Settings.SetMasterVolume( Settings.MasterVolume - 0.1f );
	void VolumeUp() => Settings.SetMasterVolume( Settings.MasterVolume + 0.1f );

	void CycleResolution()
	{
		Settings.CycleResolution();
	}

	void ToggleFullscreen()
	{
		Settings.SetFullscreen( !Settings.Fullscreen );
	}

	// The (int)(Time.Now * 30) bucket forces a rebuild ~30x/sec while the menu is up so all the
	// Time.Now-driven inline styles above actually animate - without it BuildHash only changes when
	// _screen/Settings change, and the menu would render once and freeze (same technique Hud.razor
	// uses for its own continuous effects). Bumped from 12 to 30: 12 rebuilds/sec was visibly
	// choppy for the rising/falling motes in particular, reported as "slow and laggy".
	protected override int BuildHash() => System.HashCode.Combine(
		Visible, _screen, Settings.MasterVolume, Settings.ResolutionIndex, Settings.Fullscreen,
		Outfit.Version,
		Visible ? (int)(Time.Now * 30) : 0 );
}

<style>
	.menu-root {
		width: 100%;
		height: 100%;
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: rgba(8,6,9,0.0);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.5s ease;
		font-family: Poppins;
		overflow: hidden;
	}

	.menu-root.visible {
		opacity: 1;
		pointer-events: all;
		background-color: rgba(9,6,8,0.96);
	}

	/* Customize screen shifts the panel to the left and shows nothing but the plain black
	   background + the dedicated PlayerPreviewCamera viewport (see bar.scene) on the right - no
	   ambient glow/ash competing with it. */
	.menu-root.customize-mode {
		justify-content: flex-start;
		padding-left: 6%;
	}

	.menu-root.customize-mode.visible {
		background-color: rgba(9,6,8,0.0);
	}

	.glow {
		position: absolute;
		width: 900px;
		height: 900px;
		border-radius: 50%;
		pointer-events: none;
	}

	.glow-a {
		left: -450px;
		top: -470px;
		background-image: radial-gradient( circle, rgba(224,48,58,0.9) 0%, rgba(224,48,58,0.35) 30%, rgba(224,48,58,0.08) 55%, rgba(224,48,58,0) 72% );
	}

	.glow-b {
		right: -470px;
		bottom: -510px;
		background-image: radial-gradient( circle, rgba(255,180,60,0.8) 0%, rgba(255,180,60,0.3) 30%, rgba(255,180,60,0.06) 55%, rgba(255,180,60,0) 72% );
	}

	.motes {
		position: absolute;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.mote {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}

	.mote-ember {
		background-color: rgba(255,140,55,0.9);
	}

	.mote-ash {
		background-color: rgba(198,194,188,0.65);
	}

	.panel {
		position: relative;
		width: 480px;
		background-color: rgba(16,12,16,0.96);
		border: 1px solid rgba(255,255,255,0.12);
		border-radius: 10px;
		padding: 38px 40px 34px 40px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.accent-bar {
		position: absolute;
		top: 0px;
		left: 50%;
		width: 120px;
		height: 3px;
		margin-left: -60px;
		background-color: rgba(224,48,58,0.75);
	}

	.corner {
		position: absolute;
		width: 18px;
		height: 18px;
		border-top: 2px rgba(224,48,58,0.7);
		border-left: 2px rgba(224,48,58,0.7);
	}

	.corner-tl { top: 10px; left: 10px; }

	.corner-tr {
		top: 10px;
		right: 10px;
		border-top: 2px rgba(224,48,58,0.7);
		border-left: 0;
		border-right: 2px rgba(224,48,58,0.7);
	}

	.corner-bl {
		bottom: 10px;
		left: 10px;
		border-top: 0;
		border-bottom: 2px rgba(224,48,58,0.7);
		border-left: 2px rgba(224,48,58,0.7);
	}

	.corner-br {
		bottom: 10px;
		right: 10px;
		border-top: 0;
		border-left: 0;
		border-bottom: 2px rgba(224,48,58,0.7);
		border-right: 2px rgba(224,48,58,0.7);
	}

	.title-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		width: 100%;
		margin-bottom: 28px;
		padding: 8px 0 4px 0;
	}

	.title-line1, .title-line2 {
		font-weight: 900;
		white-space: nowrap;
		text-align: center;
		width: 100%;
		color: white;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.title-line1 {
		font-size: 26px;
		letter-spacing: 10px;
		margin-bottom: 4px;
	}

	.title-line2 {
		font-size: 46px;
		letter-spacing: 5px;
	}

	.nav {
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}

	.nav-button {
		background-color: rgba(255,255,255,0.06);
		color: rgba(255,255,255,0.85);
		font-weight: 800;
		font-size: 15px;
		letter-spacing: 2px;
		padding: 14px 0;
		border-radius: 6px;
		cursor: pointer;
		margin-bottom: 10px;
		text-align: center;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.15s ease, transform 0.15s ease;
	}

	.nav-button:hover {
		background-color: rgba(255,255,255,0.14);
		transform: scale(1.02);
	}

	.nav-button.primary {
		background-color: #e0303a;
		color: white;
		font-size: 18px;
		padding: 16px 0;
	}

	.nav-button.primary:hover {
		background-color: #ff4550;
	}

	.nav-button.back {
		margin-top: 6px;
		margin-bottom: 0;
	}

	.sub-title {
		color: rgba(255,255,255,0.45);
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 3px;
		margin-bottom: 14px;
		text-align: center;
	}

	.controls {
		background-color: rgba(255,255,255,0.05);
		border-radius: 8px;
		padding: 14px 18px;
		margin-bottom: 16px;
		display: flex;
		flex-direction: column;
	}

	.control-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 4px 0;
	}

	.control-row .key {
		color: #1a1616;
		background-color: #ffd257;
		font-size: 12px;
		font-weight: 800;
		padding: 3px 10px;
		border-radius: 5px;
		letter-spacing: 1px;
	}

	.control-row .desc {
		color: rgba(255,255,255,0.78);
		font-size: 13px;
	}

	.tip {
		color: rgba(255,255,255,0.5);
		font-size: 12px;
		line-height: 1.5;
		margin-bottom: 16px;
		text-align: center;
	}

	.setting-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		background-color: rgba(255,255,255,0.05);
		border-radius: 8px;
		padding: 12px 16px;
		margin-bottom: 10px;
	}

	.setting-label {
		color: rgba(255,255,255,0.8);
		font-size: 13px;
		font-weight: 700;
	}

	.setting-control {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.stepper-button {
		width: 26px;
		height: 26px;
		background-color: rgba(255,255,255,0.12);
		color: white;
		font-weight: 800;
		border-radius: 5px;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
