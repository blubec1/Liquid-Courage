@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using DrunkenBarFight;
@inherits PanelComponent
@namespace DrunkenBarFight

<root>
	<div class="hud-root @(ShowHud ? "" : "menu-hidden")">

		<div class="vignette" style="opacity:@(VignetteOpacity); background:radial-gradient(ellipse at center, transparent 50%, @(VignetteColor) 145%); transform:rotate(@(SwayAngle)deg) translateX(@(SwayOffsetX)px) scale(1.05);"></div>

		<div class="blackout @(ShowBlackout ? "visible" : "")" style="opacity:@(BlackoutFraction); background:radial-gradient(ellipse at center, transparent @(38f - BlackoutFraction * 24f)%, black 96%);"></div>

		<div class="damage-vignette @(HasDamageFlash ? "visible" : "")" style="opacity:@(DamageFlashOpacity);"></div>

		<div class="low-hp-vignette" style="opacity:@(LowHpVignetteOpacity.ToString( "0.###" ));"></div>

		<div class="chroma-flash" style="opacity:@(ChromaFlashOpacity.ToString( "0.###" ));">
			<div class="chroma-layer chroma-red" style="transform:translateX(-@(ChromaOffsetPx.ToString( "0.#" ))px);"></div>
			<div class="chroma-layer chroma-cyan" style="transform:translateX(@(ChromaOffsetPx.ToString( "0.#" ))px);"></div>
			<div class="desat-wash"></div>
		</div>

		<div class="top-left">
			<div class="bar-label">HP</div>
			<div class="hp-bar-bg" style="box-shadow:0 0 @((6f + HeartbeatPulse01 * 14f).ToString( "0.#" ))px rgba(255,30,30,@(HeartbeatPulse01.ToString( "0.###" )));">
				<div class="hp-bar-fill" style="width:@((HpFraction * 100).ToString( "0.##" ))%;"></div>
			</div>
			<div class="hp-text">@HpText</div>

			<div class="bar-label drink-label">NEXT DRINK</div>
			<div class="drink-bar-bg">
				<div class="drink-bar-fill" style="width:@((DrinkFraction * 100).ToString( "0.##" ))%;"></div>
			</div>
			<div class="drunk-num">DRUNK <span class="drunk-num-value">@DrunkValueText</span></div>
		</div>

		<div class="top-right">
			<div class="score-text">@ScoreText</div>
			<div class="multiplier-text">@MultiplierText MULT</div>
			<div class="combo-mini-bar-bg @(ComboFlash ? "pop" : "")">
				<div class="combo-mini-bar-fill" style="width:@((ComboGraceFraction * 100).ToString( "0.##" ))%; background-color:@(ComboColor);"></div>
			</div>
		</div>

		<div class="timer-text">@TimerText</div>

		<div class="last-call-banner @(IsLastCall ? "visible" : "")">LAST CALL</div>

		<div class="milestone-toast @(HasToast ? "visible" : "")">@ToastText</div>

		<div class="drink-flash @(HasDrinkFlash ? "visible" : "")"></div>
		<div class="drink-toast @(HasDrinkToast ? "visible" : "")">@DrinkToastText</div>

		<div class="crosshair-wrap" style="left:@((CrosshairXFraction * 100).ToString( "0.##" ))%; top:@((CrosshairYFraction * 100).ToString( "0.##" ))%;">
			<div class="crosshair-dot"></div>
			<div class="cooldown-bar-bg">
				<div class="cooldown-bar-fill" style="width:@((CooldownFraction * 100).ToString( "0.##" ))%;"></div>
			</div>
		</div>

		<div class="finisher-reference">
			<div class="finisher-title">FINISHERS</div>
			@foreach ( var f in FinisherLibrary.All )
			{
				<div class="finisher-row">@f.Description &rarr; @f.Name <span class="finisher-blurb">(@f.Blurb)</span></div>
			}
		</div>

		<div class="damage-numbers-layer">
			@foreach ( var d in DamageNumberViews )
			{
				<div class="damage-number" style="left:@(d.LeftPercent.ToString( "0.##" ))%; top:@(d.TopPercent.ToString( "0.##" ))%; opacity:@(d.Opacity.ToString( "0.##" )); color:@(d.ColorHex); transform:translate(-50%,-50%) scale(@(d.Scale.ToString( "0.##" )));">@d.Text</div>
			}
		</div>

		<div class="enemy-indicators-layer">
			@foreach ( var e in EnemyIndicatorViews )
			{
				<div class="enemy-indicator" style="left:@(e.LeftPercent.ToString( "0.##" ))%; top:@(e.TopPercent.ToString( "0.##" ))%; transform:translate(-50%,-50%) rotate(@(e.AngleDeg.ToString( "0.##" ))deg);"></div>
			}
		</div>

	</div>
</root>

@code
{
	public float HpFraction
	{
		get
		{
			var p = PlayerStats.Local;
			if ( p is null || p.MaxHP <= 0 ) return 1f;
			return System.Math.Clamp( p.CurrentHP / p.MaxHP, 0f, 1f );
		}
	}

	public string HpText
	{
		get
		{
			var p = PlayerStats.Local;
			return p is null ? "--" : $"{p.CurrentHP:0} / {p.MaxHP:0}";
		}
	}

	// --- Combo (hit-connect streak) ---
	public int ComboStreak => ComboSystem.Local?.HitStreak ?? 0;
	public float ComboGraceFraction => ComboSystem.Local?.GraceFraction01 ?? 0f;

	public string ComboColor
	{
		get
		{
			var s = ComboStreak;
			if ( s >= 15 ) return "#ff3b3b";
			if ( s >= 10 ) return "#ff8a3b";
			if ( s >= 5 ) return "#ffd257";
			return "#9fe870";
		}
	}

	float _lastComboFlashEnd = -999f;
	public bool ComboFlash => Time.Now < _lastComboFlashEnd;

	void OnComboHit( int newStreak )
	{
		_lastComboFlashEnd = Time.Now + 0.18f;
	}

	// --- Drink meter ---
	public float DrinkFraction => DrinkMeter.Local?.Fraction01 ?? 0f;

	// --- Score ---
	public string ScoreText => $"SCORE  {(ScoreSystem.Local?.Score ?? 0):N0}";
	public string MultiplierText => $"x{(ScoreSystem.Local?.Multiplier ?? 1f):0.00}";

	// --- Timer ---
	public string TimerText
	{
		get
		{
			var s = GameManager.Instance?.SurvivalTime ?? 0f;
			var m = (int)(s / 60);
			var sec = (int)(s % 60);
			return $"{m:00}:{sec:00}";
		}
	}

	// --- Drunkenness VFX (deliberately no numeric bar - see DrunkennessSystem) ---
	public bool IsLastCall => DrunkennessSystem.Local?.IsLastCall ?? false;

	// Raw drunk number for the HUD readout ONLY (deliberately just the value, no bar/percent -
	// see the class doc comment on DrunkennessSystem: the number is a debug-facing readout, not a
	// bar the player is meant to play off).
	public string DrunkValueText => DrunkennessSystem.Local is null ? "0" : ((int)DrunkennessSystem.Local.Value).ToString();
	public float BlackoutFraction => DrunkennessSystem.Local?.BlackoutFraction01 ?? 0f;
	public bool ShowBlackout => BlackoutFraction > 0f;

	float DrunkFraction01
	{
		get
		{
			var d = DrunkennessSystem.Local;
			return d is null ? 0f : System.Math.Clamp( d.Value / d.MaxValue, 0f, 1f );
		}
	}

	public float VignetteOpacity => System.Math.Clamp( (DrunkFraction01 - 0.2f) / 0.8f, 0f, 1f ) * 0.55f;

	public string VignetteColor
	{
		get
		{
			var f = DrunkFraction01;
			var r = (int)(90 + 130 * f);
			var g = (int)(12 * (1f - f));
			var b = (int)(14 + 46 * f);
			return $"rgba({r},{g},{b},1)";
		}
	}

	// Subtle full-screen sway once drunkenness is meaningfully high - the "swimmy vision" cue.
	public float SwayAngle => System.MathF.Sin( Time.Now * 0.8f ) * DrunkFraction01 * 2.2f;
	public float SwayOffsetX => System.MathF.Sin( Time.Now * 0.5f ) * DrunkFraction01 * 5f;

	// --- Drink event flourish ---
	string _drinkToastText = "";
	float _drinkToastEnd = -999f;
	float _drinkFlashEnd = -999f;

	public bool HasDrinkToast => Time.Now < _drinkToastEnd;
	public bool HasDrinkFlash => Time.Now < _drinkFlashEnd;
	public string DrinkToastText => _drinkToastText;

	void OnDrinkTriggered( int glassNumber )
	{
		_drinkToastText = $"CHEERS! - GLASS #{glassNumber}";
		_drinkToastEnd = Time.Now + 2.2f;
		_drinkFlashEnd = Time.Now + 0.35f;
	}

	// --- Damage feedback ---
	float _damageFlashStart = -999f;
	float _damageFlashPeak;
	const float DamageFlashDuration = 0.4f;

	public bool HasDamageFlash => Time.Now - _damageFlashStart < DamageFlashDuration;

	public float DamageFlashOpacity
	{
		get
		{
			if ( !HasDamageFlash )
				return 0f;

			var t = System.Math.Clamp( (Time.Now - _damageFlashStart) / DamageFlashDuration, 0f, 1f );
			// Snap in, ease out - reads as a jolt rather than a slow bruise fading in.
			return _damageFlashPeak * (1f - t * t);
		}
	}

	void OnPlayerDamaged( float amount, float fraction01 )
	{
		_damageFlashStart = Time.Now;
		_damageFlashPeak = System.Math.Clamp( 0.25f + fraction01 * 1.8f, 0.25f, 0.8f );

		// Extra "disorienting" punch layered on top of the plain damage-vignette flash above, only
		// for hits big enough to matter (same 0.12 threshold HitFeedback/PlayPlayerHurt uses to pick
		// its "heavy" cue) - timed against the damage flash so the screen warp reads in sync with the
		// hit instead of the effects landing out of sync.
		if ( fraction01 >= BigHitThreshold )
		{
			_chromaFlashStart = Time.Now;
			_chromaFlashPeak = System.Math.Clamp( fraction01 * 1.4f, 0.35f, 1f );
		}
	}

	// --- Low-HP heartbeat vignette (persistent while HP is dangerously low - separate from both
	// the drunk-sway vignette above and the one-shot per-hit damage flash, so being low reads
	// continuously rather than only for the instant a hit lands) ---
	const float LowHpThreshold = 0.32f;

	/// <summary>0-1 heartbeat pulse, silent (0) above LowHpThreshold. Two quick decaying spikes per
	/// beat cycle ("lub-dub") rather than a single smooth sine, so it actually reads as a heartbeat
	/// instead of a slow breathing glow. Both rate and intensity ramp up as HP gets closer to zero.
	/// Shared by the vignette and the HP bar's glow below so they pulse in lockstep.</summary>
	public float HeartbeatPulse01
	{
		get
		{
			var frac = HpFraction;
			if ( frac >= LowHpThreshold )
				return 0f;

			var danger01 = System.Math.Clamp( 1f - frac / LowHpThreshold, 0f, 1f );
			var bpm = 70f + danger01 * 90f; // 70bpm at the threshold, up to 160bpm near death
			var phase = (Time.Now * (bpm / 60f)) % 1f;

			var pulse = Beat( phase, 0f ) + Beat( phase, 0.18f ) * 0.6f;
			var baseline = 0.1f + danger01 * 0.15f;

			return System.Math.Clamp( baseline + pulse * (0.3f + danger01 * 0.4f), 0f, 1f );
		}
	}

	/// <summary>Sharp-attack, fast-decay pulse shape (a "thump", not a symmetric sine bump) centered
	/// at the given phase offset within a 0-1 beat cycle.</summary>
	static float Beat( float phase, float offset )
	{
		var d = phase - offset;
		if ( d < 0f )
			d += 1f;

		const float width = 0.09f;
		if ( d > width )
			return 0f;

		var t = d / width;
		return (1f - t) * (1f - t);
	}

	public float LowHpVignetteOpacity => HeartbeatPulse01 * 0.85f;

	// --- Big-hit chromatic-aberration/desaturation pulse (see OnPlayerDamaged above) ---
	const float BigHitThreshold = 0.12f;
	const float ChromaFlashDuration = 0.22f;

	float _chromaFlashStart = -999f;
	float _chromaFlashPeak;

	public bool HasChromaFlash => Time.Now - _chromaFlashStart < ChromaFlashDuration;

	public float ChromaFlashOpacity
	{
		get
		{
			if ( !HasChromaFlash )
				return 0f;

			var t = System.Math.Clamp( (Time.Now - _chromaFlashStart) / ChromaFlashDuration, 0f, 1f );
			return _chromaFlashPeak * (1f - t);
		}
	}

	/// <summary>How far apart the red/cyan fringe layers sit, in px - widest right at the start of
	/// the flash, snapping back together as it fades (a "split apart then slam shut" read).</summary>
	public float ChromaOffsetPx
	{
		get
		{
			if ( !HasChromaFlash )
				return 0f;

			var t = System.Math.Clamp( (Time.Now - _chromaFlashStart) / ChromaFlashDuration, 0f, 1f );
			return (1f - t) * 10f * _chromaFlashPeak;
		}
	}

	// --- Floating damage numbers ---
	class DamageNumberEntry
	{
		public Vector3 WorldPos;
		public float Amount;
		public DamageNumberKind Kind;
		public float SpawnTime;
		public float JitterPercent;
	}

	public struct DamageNumberView
	{
		public float LeftPercent;
		public float TopPercent;
		public float Opacity;
		public float Scale;
		public string Text;
		public string ColorHex;
	}

	const float DamageNumberDuration = 0.9f;
	const int MaxDamageNumbers = 60;
	readonly List<DamageNumberEntry> _damageNumbers = new();

	static bool _loggedFirstDamageNumber;

	void OnDamageNumber( Vector3 worldPos, float amount, DamageNumberKind kind )
	{
		_damageNumbers.Add( new DamageNumberEntry
		{
			WorldPos = worldPos,
			Amount = amount,
			Kind = kind,
			SpawnTime = Time.Now,
			JitterPercent = (Random.Shared.NextSingle() - 0.5f) * 3.5f,
		} );

		// Cap so a long combat storm can't grow this list forever - drop the oldest first.
		while ( _damageNumbers.Count > MaxDamageNumbers )
			_damageNumbers.RemoveAt( 0 );

		// One-shot diagnostic so we can see in the console whether the whole projection pipeline
		// (camera resolution + PointToScreenNormal) is actually working the very first time a hit
		// lands, rather than guessing blind if numbers never show up on screen.
		if ( !_loggedFirstDamageNumber )
		{
			_loggedFirstDamageNumber = true;
			try
			{
				var cam = IsoCameraRig.Instance?.Camera ?? Scene?.Camera;
				if ( cam is null )
				{
					Log.Warning( "[DamageNumbers] No camera resolved (IsoCameraRig.Instance and Scene.Camera both null) - damage numbers will never show." );
				}
				else
				{
					var sp = cam.PointToScreenNormal( worldPos + Vector3.Up * 55f );
					Log.Info( $"[DamageNumbers] First hit: worldPos={worldPos} camPos={cam.WorldPosition} screenNormal=({sp.x:0.###},{sp.y:0.###}) - expect roughly 0..1 on both axes if this is on-screen." );
				}
			}
			catch ( System.Exception ex )
			{
				Log.Warning( $"[DamageNumbers] Diagnostic projection threw: {ex.Message}" );
			}
		}
	}

	/// <summary>Projects each live damage number from its world position onto the screen, rising and
	/// fading over its lifetime. Anything expired or off-screen is skipped (and pruned lazily here
	/// rather than needing a separate OnUpdate tick).</summary>
	public IEnumerable<DamageNumberView> DamageNumberViews
	{
		get
		{
			var cam = IsoCameraRig.Instance?.Camera ?? Scene?.Camera;
			if ( cam is null )
				yield break;

			var now = Time.Now;

			for ( int i = _damageNumbers.Count - 1; i >= 0; i-- )
			{
				var d = _damageNumbers[i];
				var elapsed = now - d.SpawnTime;

				if ( elapsed > DamageNumberDuration )
				{
					_damageNumbers.RemoveAt( i );
					continue;
				}

				if ( elapsed < 0f )
					continue;

				var t = elapsed / DamageNumberDuration;
				var risePos = d.WorldPos + Vector3.Up * (t * 55f);

				var toPoint = risePos - cam.WorldPosition;
				if ( Vector3.Dot( cam.WorldRotation.Forward, toPoint.Normal ) < 0.1f )
					continue;

				var sp = cam.PointToScreenNormal( risePos );
				if ( sp.x < -0.05f || sp.x > 1.05f || sp.y < -0.05f || sp.y > 1.05f )
					continue;

				var opacity = t < 0.65f ? 1f : 1f - (t - 0.65f) / 0.35f;
				var scale = t < 0.15f ? (0.6f + 0.4f * (t / 0.15f)) : 1f;

				yield return new DamageNumberView
				{
					LeftPercent = sp.x * 100f + d.JitterPercent,
					TopPercent = sp.y * 100f,
					Opacity = opacity,
					Scale = scale,
					Text = $"{d.Amount:0}",
					ColorHex = d.Kind switch
					{
						DamageNumberKind.Finisher => "#ffd257",
						DamageNumberKind.PlayerDamage => "#ff4d4d",
						_ => "#ffffff",
					},
				};
			}
		}
	}

	// --- Off-screen enemy direction indicators ---
	public struct EnemyIndicatorView
	{
		public float LeftPercent;
		public float TopPercent;
		public float AngleDeg;
	}

	/// <summary>For every living enemy currently outside the visible screen rect, returns a marker
	/// clamped to the screen edge and rotated to point toward it - the fixed-height orthographic
	/// camera means enemies spawning on the far side of the 800-unit ring can approach with zero
	/// warning otherwise.</summary>
	public IEnumerable<EnemyIndicatorView> EnemyIndicatorViews
	{
		get
		{
			var cam = IsoCameraRig.Instance?.Camera ?? Scene?.Camera;
			if ( cam is null || GameManager.Instance?.State != RunState.Playing )
				yield break;

			const float margin = 0.07f;
			const float half = 0.5f - margin;

			foreach ( var enemy in EnemyBase.All )
			{
				if ( enemy is null || !enemy.IsValid || enemy.IsDead )
					continue;

				var worldPos = enemy.WorldPosition + Vector3.Up * 40f;
				var toPoint = worldPos - cam.WorldPosition;
				if ( Vector3.Dot( cam.WorldRotation.Forward, toPoint.Normal ) < 0.1f )
					continue;

				var sp = cam.PointToScreenNormal( worldPos );

				var onScreen = sp.x >= margin && sp.x <= 1f - margin && sp.y >= margin && sp.y <= 1f - margin;
				if ( onScreen )
					continue;

				var dx = sp.x - 0.5f;
				var dy = sp.y - 0.5f;
				if ( System.MathF.Abs( dx ) < 0.0001f && System.MathF.Abs( dy ) < 0.0001f )
					continue;

				var tX = dx != 0f ? half / System.MathF.Abs( dx ) : float.MaxValue;
				var tY = dy != 0f ? half / System.MathF.Abs( dy ) : float.MaxValue;
				var t = System.MathF.Min( tX, tY );

				yield return new EnemyIndicatorView
				{
					LeftPercent = (0.5f + dx * t) * 100f,
					TopPercent = (0.5f + dy * t) * 100f,
					AngleDeg = System.MathF.Atan2( dy, dx ) * (180f / System.MathF.PI),
				};
			}
		}
	}

	// --- Cooldown / crosshair ---
	public float CooldownFraction => PlayerCombat.Local?.CooldownFraction01 ?? 1f;

	// The HUD's ScreenPanel auto-scales its own coordinate space to a fixed virtual height, so
	// raw Mouse.Position (real screen pixels) doesn't line up with panel-space px unless the real
	// window happens to be exactly that height - that's what was causing the misalignment.
	// Converting to a 0-1 fraction of the real screen and positioning with percentages instead of
	// px sidesteps the scale factor entirely, since .hud-root is always 100% of the real screen.
	public float CrosshairXFraction => Screen.Width > 0 ? Mouse.Position.x / Screen.Width : 0.5f;
	public float CrosshairYFraction => Screen.Height > 0 ? Mouse.Position.y / Screen.Height : 0.5f;

	// Hidden entirely while the main menu is up - a fresh main-menu screen shouldn't show HP/combo/
	// timer bleeding through behind it before a run has even started.
	public bool ShowHud => GameManager.Instance?.State != RunState.MainMenu;

	// --- Milestone toasts ---
	string _toastText = "";
	float _toastEndTime = -999f;

	public bool HasToast => Time.Now < _toastEndTime;
	public string ToastText => _toastText;

	void OnMilestone( string text )
	{
		_toastText = text;
		_toastEndTime = Time.Now + 3.5f;
	}

	void OnSoberUpPerformed()
	{
		_toastText = "SOBER UP";
		_toastEndTime = Time.Now + 1.6f;
	}

	protected override void OnStart()
	{
		GameEvents.Milestone += OnMilestone;
		GameEvents.DrinkTriggered += OnDrinkTriggered;
		GameEvents.SoberUpPerformed += OnSoberUpPerformed;
		GameEvents.ComboHit += OnComboHit;
		GameEvents.PlayerDamaged += OnPlayerDamaged;
		GameEvents.DamageNumber += OnDamageNumber;
	}

	protected override void OnDestroy()
	{
		GameEvents.Milestone -= OnMilestone;
		GameEvents.DrinkTriggered -= OnDrinkTriggered;
		GameEvents.SoberUpPerformed -= OnSoberUpPerformed;
		GameEvents.ComboHit -= OnComboHit;
		GameEvents.PlayerDamaged -= OnPlayerDamaged;
		GameEvents.DamageNumber -= OnDamageNumber;
	}

	// s&box Razor panels only rebuild when this hash changes - without it the HUD renders once
	// and then never updates, no matter how much the underlying data changes. The coarse time
	// bucket in h2 is what keeps the sway/timer/vignette animating smoothly frame to frame.
	protected override int BuildHash()
	{
		// HashCode.Combine only has overloads for up to 8 arguments, so this is split into two
		// nested groups rather than one call with 9.
		var h1a = System.HashCode.Combine(
			PlayerStats.Local?.CurrentHP,
			PlayerStats.Local?.MaxHP,
			ComboStreak,
			System.MathF.Round( ComboGraceFraction, 2 ),
			ComboFlash,
			ScoreSystem.Local?.Score,
			ScoreSystem.Local?.Multiplier,
			System.MathF.Round( DrinkFraction, 2 ) );

		var h1 = System.HashCode.Combine( h1a, _toastText );

		var h2 = System.HashCode.Combine(
			HasToast,
			HasDrinkToast,
			HasDrinkFlash,
			_drinkToastText,
			CrosshairXFraction,
			CrosshairYFraction,
			(int)(Time.Now * 12),
			PlayerCombat.Local?.CooldownFraction01 );

		return System.HashCode.Combine( h1, h2, ShowHud, HasDamageFlash, HasChromaFlash, _damageNumbers.Count );
	}
}

<style>
	.hud-root {
		width: 100%;
		height: 100%;
		position: absolute;
		font-family: Poppins;
		pointer-events: none;
		opacity: 1;
		transition: opacity 0.3s;
	}

	.hud-root.menu-hidden {
		opacity: 0;
	}

	.vignette {
		position: absolute;
		width: 100%;
		height: 100%;
		transition: opacity 0.3s ease;
	}

	.blackout {
		position: absolute;
		width: 100%;
		height: 100%;
		transition: opacity 0.5s ease;
	}

	.damage-vignette {
		position: absolute;
		width: 100%;
		height: 100%;
		opacity: 0;
		background: radial-gradient(ellipse at center, transparent 35%, rgba(180,0,10,0.9) 100%);
	}

	.low-hp-vignette {
		position: absolute;
		width: 100%;
		height: 100%;
		background: radial-gradient(ellipse at center, transparent 38%, rgba(160,0,0,0.9) 100%);
		opacity: 0;
	}

	.chroma-flash {
		position: absolute;
		width: 100%;
		height: 100%;
		opacity: 0;
	}

	.chroma-layer {
		position: absolute;
		width: 100%;
		height: 100%;
		mix-blend-mode: screen;
	}

	.chroma-red {
		background: radial-gradient(ellipse at center, transparent 12%, rgba(255,30,30,0.55) 130%);
	}

	.chroma-cyan {
		background: radial-gradient(ellipse at center, transparent 12%, rgba(30,220,255,0.5) 130%);
	}

	.desat-wash {
