@using Sandbox;
@using Sandbox.UI;
@using DrunkenBarFight;
@inherits PanelComponent
@namespace DrunkenBarFight

<root>
	<div class="hud-root @(ShowHud ? "" : "menu-hidden")">

		<div class="vignette" style="opacity:@(VignetteOpacity); background:radial-gradient(ellipse at center, transparent 50%, @(VignetteColor) 145%); transform:rotate(@(SwayAngle)deg) translateX(@(SwayOffsetX)px) scale(1.05);"></div>

		<div class="blackout @(ShowBlackout ? "visible" : "")" style="opacity:@(BlackoutFraction); background:radial-gradient(ellipse at center, transparent @(38f - BlackoutFraction * 24f)%, black 96%);"></div>

		<div class="top-left">
			<div class="bar-label">HP</div>
			<div class="hp-bar-bg">
				<div class="hp-bar-fill" style="width:@((HpFraction * 100).ToString( "0.##" ))%;"></div>
			</div>
			<div class="hp-text">@HpText</div>

			<div class="bar-label drink-label">NEXT DRINK</div>
			<div class="drink-bar-bg">
				<div class="drink-bar-fill" style="width:@((DrinkFraction * 100).ToString( "0.##" ))%;"></div>
			</div>
		</div>

		<div class="top-right">
			<div class="score-text">@ScoreText</div>
			<div class="multiplier-text">@MultiplierText MULT</div>
			<div class="combo-mini-bar-bg @(ComboFlash ? "pop" : "")">
				<div class="combo-mini-bar-fill" style="width:@((ComboGraceFraction * 100).ToString( "0.##" ))%; background-color:@(ComboColor);"></div>
			</div>
		</div>

		<div class="timer-text">@TimerText</div>

		<div class="last-call-banner @(IsLastCall ? "visible" : "")">LAST CALL</div>

		<div class="milestone-toast @(HasToast ? "visible" : "")">@ToastText</div>

		<div class="drink-flash @(HasDrinkFlash ? "visible" : "")"></div>
		<div class="drink-toast @(HasDrinkToast ? "visible" : "")">@DrinkToastText</div>

		<div class="crosshair-wrap" style="left:@((CrosshairXFraction * 100).ToString( "0.##" ))%; top:@((CrosshairYFraction * 100).ToString( "0.##" ))%;">
			<div class="crosshair-dot"></div>
			<div class="cooldown-bar-bg">
				<div class="cooldown-bar-fill" style="width:@((CooldownFraction * 100).ToString( "0.##" ))%;"></div>
			</div>
		</div>

		<div class="finisher-reference">
			<div class="finisher-title">FINISHERS</div>
			@foreach ( var f in FinisherLibrary.All )
			{
				<div class="finisher-row">@f.Description &rarr; @f.Name</div>
			}
		</div>

	</div>
</root>

@code
{
	public float HpFraction
	{
		get
		{
			var p = PlayerStats.Local;
			if ( p is null || p.MaxHP <= 0 ) return 1f;
			return System.Math.Clamp( p.CurrentHP / p.MaxHP, 0f, 1f );
		}
	}

	public string HpText
	{
		get
		{
			var p = PlayerStats.Local;
			return p is null ? "--" : $"{p.CurrentHP:0} / {p.MaxHP:0}";
		}
	}

	// --- Combo (hit-connect streak) ---
	public int ComboStreak => ComboSystem.Local?.HitStreak ?? 0;
	public float ComboGraceFraction => ComboSystem.Local?.GraceFraction01 ?? 0f;

	public string ComboColor
	{
		get
		{
			var s = ComboStreak;
			if ( s >= 15 ) return "#ff3b3b";
			if ( s >= 10 ) return "#ff8a3b";
			if ( s >= 5 ) return "#ffd257";
			return "#9fe870";
		}
	}

	float _lastComboFlashEnd = -999f;
	public bool ComboFlash => Time.Now < _lastComboFlashEnd;

	void OnComboHit( int newStreak )
	{
		_lastComboFlashEnd = Time.Now + 0.18f;
	}

	// --- Drink meter ---
	public float DrinkFraction => DrinkMeter.Local?.Fraction01 ?? 0f;

	// --- Score ---
	public string ScoreText => $"SCORE  {(ScoreSystem.Local?.Score ?? 0):N0}";
	public string MultiplierText => $"x{(ScoreSystem.Local?.Multiplier ?? 1f):0.00}";

	// --- Timer ---
	public string TimerText
	{
		get
		{
			var s = GameManager.Instance?.SurvivalTime ?? 0f;
			var m = (int)(s / 60);
			var sec = (int)(s % 60);
			return $"{m:00}:{sec:00}";
		}
	}

	// --- Drunkenness VFX (deliberately no numeric bar - see DrunkennessSystem) ---
	public bool IsLastCall => DrunkennessSystem.Local?.IsLastCall ?? false;
	public float BlackoutFraction => DrunkennessSystem.Local?.BlackoutFraction01 ?? 0f;
	public bool ShowBlackout => BlackoutFraction > 0f;

	float DrunkFraction01
	{
		get
		{
			var d = DrunkennessSystem.Local;
			return d is null ? 0f : System.Math.Clamp( d.Value / d.MaxValue, 0f, 1f );
		}
	}

	public float VignetteOpacity => System.Math.Clamp( (DrunkFraction01 - 0.2f) / 0.8f, 0f, 1f ) * 0.55f;

	public string VignetteColor
	{
		get
		{
			var f = DrunkFraction01;
			var r = (int)(90 + 130 * f);
			var g = (int)(12 * (1f - f));
			var b = (int)(14 + 46 * f);
			return $"rgba({r},{g},{b},1)";
		}
	}

	// Subtle full-screen sway once drunkenness is meaningfully high - the "swimmy vision" cue.
	public float SwayAngle => System.MathF.Sin( Time.Now * 0.8f ) * DrunkFraction01 * 2.2f;
	public float SwayOffsetX => System.MathF.Sin( Time.Now * 0.5f ) * DrunkFraction01 * 5f;

	// --- Drink event flourish ---
	string _drinkToastText = "";
	float _drinkToastEnd = -999f;
	float _drinkFlashEnd = -999f;

	public bool HasDrinkToast => Time.Now < _drinkToastEnd;
	public bool HasDrinkFlash => Time.Now < _drinkFlashEnd;
	public string DrinkToastText => _drinkToastText;

	void OnDrinkTriggered( int glassNumber )
	{
		_drinkToastText = $"CHEERS! - GLASS #{glassNumber}";
		_drinkToastEnd = Time.Now + 2.2f;
		_drinkFlashEnd = Time.Now + 0.35f;
	}

	// --- Cooldown / crosshair ---
	public float CooldownFraction => PlayerCombat.Local?.CooldownFraction01 ?? 1f;

	// The HUD's ScreenPanel auto-scales its own coordinate space to a fixed virtual height, so
	// raw Mouse.Position (real screen pixels) doesn't line up with panel-space px unless the real
	// window happens to be exactly that height - that's what was causing the misalignment.
	// Converting to a 0-1 fraction of the real screen and positioning with percentages instead of
	// px sidesteps the scale factor entirely, since .hud-root is always 100% of the real screen.
	public float CrosshairXFraction => Screen.Width > 0 ? Mouse.Position.x / Screen.Width : 0.5f;
	public float CrosshairYFraction => Screen.Height > 0 ? Mouse.Position.y / Screen.Height : 0.5f;

	// Hidden entirely while the main menu is up - a fresh main-menu screen shouldn't show HP/combo/
	// timer bleeding through behind it before a run has even started.
	public bool ShowHud => GameManager.Instance?.State != RunState.MainMenu;

	// --- Milestone toasts ---
	string _toastText = "";
	float _toastEndTime = -999f;

	public bool HasToast => Time.Now < _toastEndTime;
	public string ToastText => _toastText;

	void OnMilestone( string text )
	{
		_toastText = text;
		_toastEndTime = Time.Now + 3.5f;
	}

	protected override void OnStart()
	{
		GameEvents.Milestone += OnMilestone;
		GameEvents.DrinkTriggered += OnDrinkTriggered;
		GameEvents.ComboHit += OnComboHit;
	}

	protected override void OnDestroy()
	{
		GameEvents.Milestone -= OnMilestone;
		GameEvents.DrinkTriggered -= OnDrinkTriggered;
		GameEvents.ComboHit -= OnComboHit;
	}

	// s&box Razor panels only rebuild when this hash changes - without it the HUD renders once
	// and then never updates, no matter how much the underlying data changes. The coarse time
	// bucket in h2 is what keeps the sway/timer/vignette animating smoothly frame to frame.
	protected override int BuildHash()
	{
		// HashCode.Combine only has overloads for up to 8 arguments, so this is split into two
		// nested groups rather than one call with 9.
		var h1a = System.HashCode.Combine(
			PlayerStats.Local?.CurrentHP,
			PlayerStats.Local?.MaxHP,
			ComboStreak,
			System.MathF.Round( ComboGraceFraction, 2 ),
			ComboFlash,
			ScoreSystem.Local?.Score,
			ScoreSystem.Local?.Multiplier,
			System.MathF.Round( DrinkFraction, 2 ) );

		var h1 = System.HashCode.Combine( h1a, _toastText );

		var h2 = System.HashCode.Combine(
			HasToast,
			HasDrinkToast,
			HasDrinkFlash,
			_drinkToastText,
			CrosshairXFraction,
			CrosshairYFraction,
			(int)(Time.Now * 12),
			PlayerCombat.Local?.CooldownFraction01 );

		return System.HashCode.Combine( h1, h2, ShowHud );
	}
}

<style>
	.hud-root {
		width: 100%;
		height: 100%;
		position: absolute;
		font-family: Poppins;
		pointer-events: none;
		opacity: 1;
		transition: opacity 0.3s;
	}

	.hud-root.menu-hidden {
		opacity: 0;
	}

	.vignette {
		position: absolute;
		width: 100%;
		height: 100%;
		transition: opacity 0.3s ease;
	}

	.blackout {
		position: absolute;
		width: 100%;
		height: 100%;
		transition: opacity 0.5s ease;
	}

	.top-left {
		position: absolute;
		left: 32px;
		top: 28px;
		width: 340px;
		display: flex;
		flex-direction: column;
	}

	.bar-label {
		color: white;
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 2px;
		text-shadow: 0 2px 4px black;
	}

	.drink-label {
		margin-top: 14px;
		color: #ffd257;
	}

	.hp-bar-bg, .drink-bar-bg {
		width: 100%;
		height: 22px;
		background-color: rgba(0,0,0,0.55);
		border: 2px solid rgba(255,255,255,0.25);
		border-radius: 4px;
		overflow: hidden;
		margin-top: 4px;
	}

	.hp-bar-fill {
		height: 100%;
		background-color: #e0303a;
		transition: width 0.15s ease-out;
	}

	.drink-bar-fill {
		height: 100%;
		background-color: #e8a33d;
		transition: width 0.2s ease-out;
	}

	.hp-text {
		color: white;
		font-size: 13px;
		margin-top: 2px;
		text-shadow: 0 2px 4px black;
	}

	.top-right {
		position: absolute;
		right: 32px;
		top: 28px;
		text-align: right;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.score-text {
		color: white;
		font-size: 30px;
		font-weight: 800;
		text-shadow: 0 2px 6px black;
	}

	.multiplier-text {
		color: #ffd257;
		font-size: 18px;
		font-weight: 700;
		text-shadow: 0 2px 4px black;
	}

	.combo-mini-bar-bg {
		width: 130px;
		height: 7px;
		background-color: rgba(0,0,0,0.5);
		border: 1px solid rgba(255,255,255,0.2);
		border-radius: 3px;
		overflow: hidden;
		margin-top: 8px;
		transition: transform 0.15s ease-out;
	}

	.combo-mini-bar-bg.pop {
		transform: scaleY(1.9);
	}

	.combo-mini-bar-fill {
		height: 100%;
		transition: width 0.1s linear, background-color 0.2s ease;
	}

	.timer-text {
		position: absolute;
		top: 28px;
		left: 50%;
		transform: translateX(-50%);
		color: white;
		font-size: 22px;
		font-weight: 800;
		letter-spacing: 1px;
		text-shadow: 0 2px 6px black;
	}

	.last-call-banner {
		position: absolute;
		top: 90px;
		left: 50%;
		transform: translateX(-50%);
		color: #ff3b3b;
		font-size: 34px;
		font-weight: 900;
		letter-spacing: 6px;
		text-shadow: 0 0 20px rgba(255,0,0,0.8);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.last-call-banner.visible {
		opacity: 1;
	}

	.milestone-toast {
		position: absolute;
		top: 140px;
		left: 50%;
		transform: translateX(-50%);
		color: white;
		font-size: 20px;
		font-weight: 700;
		text-shadow: 0 2px 6px black;
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.milestone-toast.visible {
		opacity: 1;
	}

	.drink-flash {
		position: absolute;
		width: 100%;
		height: 100%;
		background-color: white;
		opacity: 0;
		transition: opacity 0.35s ease-out;
	}

	.drink-flash.visible {
		opacity: 0.35;
		transition: opacity 0.05s ease-in;
	}

	.drink-toast {
		position: absolute;
		top: 190px;
		left: 50%;
		transform: translateX(-50%) scale(0.85);
		color: #ffd257;
		font-size: 26px;
		font-weight: 900;
		letter-spacing: 3px;
		text-shadow: 0 2px 10px black;
		opacity: 0;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.drink-toast.visible {
		opacity: 1;
		transform: translateX(-50%) scale(1);
	}

	.crosshair-wrap {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: center;
		transform: translate(-50%, -50%);
	}

	.crosshair-dot {
		width: 6px;
		height: 6px;
		background-color: white;
		border-radius: 50%;
		box-shadow: 0 0 4px black;
	}

	.cooldown-bar-bg {
		width: 60px;
		height: 6px;
		background-color: rgba(0,0,0,0.5);
		border-radius: 3px;
		overflow: hidden;
		margin-top: 8px;
	}

	.cooldown-bar-fill {
		height: 100%;
		background-color: #58e070;
	}

	.finisher-reference {
		position: absolute;
		left: 32px;
		bottom: 28px;
		background-color: rgba(0,0,0,0.4);
		border-radius: 6px;
		padding: 10px 14px;
		display: flex;
		flex-direction: column;
	}

	.finisher-title {
		color: #ffd257;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 2px;
		margin-bottom: 4px;
	}

	.finisher-row {
		color: white;
		font-size: 12px;
		opacity: 0.85;
	}
</style>
